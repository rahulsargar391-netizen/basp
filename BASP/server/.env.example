# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Supabase PostgreSQL ----
DB_DIALECT=postgres
DB_CREATE_DATABASE=false
DB_SSL=true
DB_SSL_CA_FILE=
DATABASE_URL=
SUPABASE_DB_URL=

# MySQL is disabled for this deployment. Do not uncomment these unless switching back.
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=basp_v2
# DB_USER=root
# DB_PASSWORD=

# Local upload directory. On Render, configure a persistent disk before accepting uploads.
UPLOAD_DIR=./uploads

# ---- Login tokens (setup-env.js replaces CHANGE_ME with a random secret) ----
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# ---- Used only when seeding a completely empty database ----
ADMIN_NAME=BASP Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=
