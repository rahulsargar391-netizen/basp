# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database (local MySQL defaults; Supabase uses PostgreSQL settings) ----
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=basp_v2
DB_USER=root
DB_PASSWORD=
DB_CREATE_DATABASE=true
DB_SSL=false
DB_SSL_CA_FILE=
DATABASE_URL=

# Set DB_DIALECT=postgres, DB_CREATE_DATABASE=false, DB_SSL=true, and provide
# DATABASE_URL (or SUPABASE_DB_URL) for a Supabase PostgreSQL connection.
SUPABASE_DB_URL=
UPLOAD_DIR=./uploads

# ---- Login tokens (setup-env.js replaces CHANGE_ME with a random secret) ----
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# ---- Admin account created by "npm run seed" (testing only!) ----
ADMIN_NAME=BASP Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@1234
