# ---- Server ----
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database (XAMPP MySQL: user root, empty password) ----
# The database is created automatically if it does not exist.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=basp_v2
DB_USER=root
DB_PASSWORD=
DB_CREATE_DATABASE=true
DB_SSL=false
UPLOAD_DIR=./uploads

# ---- Login tokens (setup-env.js replaces CHANGE_ME with a random secret) ----
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# ---- Admin account created by "npm run seed" (testing only!) ----
ADMIN_NAME=BASP Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@1234
